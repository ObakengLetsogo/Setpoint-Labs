// Regenerates data/written.ts, the list of lessons that have content, so the client catalogue can
// mark the rest as planned without importing any lesson content. Run after adding a lesson.
import { writeFileSync } from "node:fs";
import { lessons } from "../../data/lessons/index";

const ids = lessons.filter((l) => !l.locked).map((l) => l.id);
writeFileSync(
  "data/written.ts",
  `// Generated by scripts/content/written.mts. Do not edit by hand.\nexport const WRITTEN = new Set<string>(${JSON.stringify(ids, null, 2)});\n`,
);
console.log(`${ids.length} written lessons`);
