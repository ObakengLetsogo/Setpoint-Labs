# Copy to .env.local in development or /etc/setpoint/env on the server. Never commit real values.

# Public origin of the site, used in emails and payment return links.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://setpointlabs.co.za

# MySQL 8.4, a dedicated least privilege user on localhost.
DATABASE_URL=mysql://setpoint:CHANGE_ME@localhost:3306/setpoint

# Payments: "stitch" in production, "dev" for the local simulator.
PAYMENT_PROVIDER=dev
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
# The whsec_ secret returned when the webhook subscription is created.
STITCH_WEBHOOK_SECRET=
VAT_NUMBER=

# Transactional email over your own domain. Without SMTP_HOST, mail is logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Setpoint Labs <hello@setpointlabs.co.za>"

# Seeds a platform admin on `npm run db:seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signs short lived video URLs.
VIDEO_URL_SECRET=

# Authorises the daily renewals job (at least 16 characters).
CRON_SECRET=

# Lesson videos: a private folder outside the web root, and the key that signs their links.
VIDEO_DIR=/var/lib/setpoint/videos
# 1 in production: Nginx serves video bytes from an internal location after the app checks the link.
VIDEO_ACCEL=0
